# --- Entorno ---
APP_ENV=development
APP_DEBUG=false

# --- Base de datos ---
# Desarrollo y tests: SQLite (async). Producción: PostgreSQL.
DATABASE_URL=sqlite+aiosqlite:///./app.db
DATABASE_URL_SYNC=sqlite:///./app.db
# PostgreSQL (producción / docker compose):
# DATABASE_URL=postgresql+psycopg://app:app@db:5432/app
# DATABASE_URL_SYNC=postgresql+psycopg://app:app@db:5432/app
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# --- Logging ---
LOG_LEVEL=INFO
LOG_JSON=true

# --- Reglas de negocio de exámenes ---
EXAMS_MIN_QUESTIONS=25
EXAMS_MAX_QUESTIONS=50
EXAMS_MAX_OPTIONS=4
EXAMS_MAX_TEXT_LENGTH=2000
EXAMS_MIN_OPTIONS=2
EXAMS_MAX_REVIEW_ATTEMPTS=3

# --- Aleatorización ---
KEYS_MIN_COUNT=2
KEYS_MAX_COUNT=26
KEYS_REQUIRE_DISTINCT_QUESTION_ORDER=true
KEYS_REQUIRE_DISTINCT_CORRECT_LETTER=true
KEYS_MIN_POSITION_SHIFT=0
KEYS_MAX_SAMPLING_ATTEMPTS=1000

# --- Documentos ---
DOCS_OUTPUT_DIR=./output
DOCS_TEMPLATE_MODE=DEFAULT
# Adaptador de exportación a PDF (LibreOffice headless). Opcional y deshabilitado por defecto.
PDF_ADAPTER_ENABLED=false
SOFFICE_BINARY=soffice
PDF_CONVERT_TIMEOUT_SECONDS=120

# --- API ---
API_TITLE=Plataforma de Automatización Académica
API_VERSION=0.1.0
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173"]
